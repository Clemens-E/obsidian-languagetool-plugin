{
  "name": "obsidian-languagetool-plugin",
  "version": "0.9.7",
  "description": "An Obsidian plugin that provides grammar and spell checking through LanguageTool integration",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.local.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "lint": "eslint .",
    "slint": "stylelint styles.css",
    "lint:fix": "eslint . --fix",
    "slint:fix": "stylelint styles.css --fix",
    "prettier": "prettier --write --use-tabs --single-quote --print-width 120 --trailing-comma all --end-of-line lf"
  },
  "keywords": [],
  "author": "Clemens Ertle",
  "contributors": [
    {
      "name": "Clemens Ertle",
      "url": "https://github.com/Clemens-E"
    },
    {
      "name": "Matthew Meyers",
      "url": "https://github.com/mgmeyers"
    }
  ],
  "repository": {
    "url": "https://github.com/Clemens-E/obsidian-languagetool-plugin"
  },
  "devDependencies": {
    "@codemirror/language": "https://github.com/lishid/cm-language",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "9.30.1",
    "@eslint/json": "0.14.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.11.6",
    "@types/prettier": "^2.2.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@wdio/cli": "^9.31.2",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "esbuild": "0.25.5",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "14.0.0",
    "jiti": "2.6.1",
    "obsidian": "1.13.1",
    "prettier": "^1.19.1",
    "stylelint": "^13.12.0",
    "stylelint-config-standard": "^21.0.0",
    "stylelint-prettier": "^1.2.0",
    "tslib": "2.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.67.0",
    "wdio-obsidian-reporter": "^3.2.0",
    "wdio-obsidian-service": "^3.2.0",
    "webdriverio": "^9.31.2"
  },
  "dependencies": {
    "annotatedtext-remark": "^1.0.10",
    "quick-lru": "^6.0.0"
  },
  "stylelint": {
    "extends": "stylelint-config-standard"
  },
  "resolutions": {
    "eslint": "^9.30.1",
    "typescript-eslint": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/utils": "8.67.0",
    "@typescript-eslint/types": "8.67.0"
  }
}
